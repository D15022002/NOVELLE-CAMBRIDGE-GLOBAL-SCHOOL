{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@10.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs'); try{fs.unlinkSync('package-lock.json')}catch(e){} try{fs.unlinkSync('yarn.lock')}catch(e){}; if(!process.env.npm_config_user_agent?.includes('pnpm')){console.error('Use pnpm instead'); process.exit(1)}\"",
    "vercel-install": "pnpm install --no-frozen-lockfile",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.4",
    "typescript": "~5.9.3"
  }
}
