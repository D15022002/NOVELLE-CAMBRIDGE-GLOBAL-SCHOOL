{
  "name": "cambridge-global-school-website",
  "version": "0.0.0",
  "packageManager": "pnpm@10.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs'); try{fs.unlinkSync('package-lock.json')}catch(e){} try{fs.unlinkSync('yarn.lock')}catch(e){}; if(!process.env.npm_config_user_agent?.includes('pnpm')){console.error('Use pnpm instead'); process.exit(1)}\"",
    "dev": "corepack pnpm --filter @workspace/cambridge-montessori run dev",
    "build": "corepack pnpm --filter @workspace/cambridge-montessori run build",
    "serve": "corepack pnpm --filter @workspace/cambridge-montessori run serve",
    "typecheck": "corepack pnpm --filter @workspace/cambridge-montessori run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.4",
    "typescript": "~5.9.3"
  }
}
