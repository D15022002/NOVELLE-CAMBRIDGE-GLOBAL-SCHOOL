{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "corepack pnpm --filter @workspace/api-server run build && corepack pnpm --filter @workspace/cambridge-montessori run build",
  "outputDirectory": "artifacts/cambridge-montessori/dist/public",
  "functions": {
    "api/server.js": {
      "includeFiles": "artifacts/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/server.js"
    }
  ]
}