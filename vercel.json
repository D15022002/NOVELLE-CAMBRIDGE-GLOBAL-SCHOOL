{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/api-server run build; BASE_PATH=/ pnpm --filter @workspace/cambridge-montessori run build",
  "outputDirectory": "artifacts/cambridge-montessori/dist/public",
  "functions": {
    "api/index.js": {
      "includeFiles": "artifacts/api-server/dist/**"
    },
    "api/[...path].js": {
      "includeFiles": "artifacts/api-server/dist/**"
    }
  }
}